# Core local project configuration
DATABASE_URL=sqlite:///database/transparencia.db

# Chatbot runtime configuration
# OpenAI is the only supported provider in this phase.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sua_chave_openai_aqui

# Optional Docker overrides used by compose.yaml.
# DOCKER_PORT=8501
# DOCKER_DATABASE_URL=sqlite:////app/runtime/database/transparencia.db
# DOCKER_RAG_PERSIST_DIRECTORY=/app/runtime/vector_store/knowledge_markdown
# AUTO_BOOTSTRAP_ON_START=1

# Optional pluggable observability configuration.
# The runtime uses a no-op provider by default and only exports spans when
# OBSERVABILITY_ENABLED=true and OBSERVABILITY_PROVIDER=langsmith.
# OBSERVABILITY_ENABLED=false
# OBSERVABILITY_PROVIDER=noop
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_PROVIDER=langsmith
# LANGSMITH_API_KEY=<your-api-key>
# LANGSMITH_PROJECT=<your-project-name>
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
